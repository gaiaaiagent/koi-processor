# KOI Processor - Personal Deployment Configuration
# Generated by setup-node.sh for {{NODE_NAME}}
#
# Usage: source config/personal.env && uvicorn api.personal_ingest_api:app --host 0.0.0.0 --port 8351

# ============================================
# DEPLOYMENT MODE
# ============================================
KOI_MODE=personal

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_URL=postgresql:///personal_koi

# ============================================
# KOI PIPELINE CONFIGURATION
# ============================================
USE_ISOLATED_TABLES=true

# Local KOI Coordinator (if running)
KOI_COORDINATOR_URL=http://localhost:8005

# Event Bridge port
EVENT_BRIDGE_PORT=8100

# ============================================
# EMBEDDING CONFIGURATION
# ============================================
# Provider: "openai", "ollama", or "" (empty = disabled, no semantic matching)
# If unset and OPENAI_API_KEY is present, auto-selects "openai" (backward compat)
EMBEDDING_PROVIDER={{EMBEDDING_PROVIDER}}
EMBEDDING_MODEL={{EMBEDDING_MODEL}}
# EMBEDDING_DIMENSION=        # optional override (default from provider)

# Provider-specific keys (only needed for your chosen provider):
OPENAI_API_KEY="{{OPENAI_API_KEY}}"
# OLLAMA_BASE_URL=http://localhost:11434  # for ollama provider

# ============================================
# PERSONAL KOI API
# ============================================
KOI_API_PORT=8351

# ============================================
# OBSIDIAN VAULT CONFIGURATION
# ============================================
OBSIDIAN_VAULT_PATH={{OBSIDIAN_VAULT_PATH}}
OBSIDIAN_VAULT_NAME=personal

# ============================================
# PROCESSING CONFIGURATION
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CONTENT_LENGTH=50
CHUNK_PROCESSING_DELAY=0.05

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# CODE GRAPH (disabled for personal)
# ============================================
CODE_GRAPH_ENABLED=false

# ============================================
# KNOWLEDGE GRAPH EXTRACTION
# ============================================
KG_EXTRACTION_ENABLED=true

# ============================================
# KOI-NET FEDERATION
# ============================================
KOI_NET_ENABLED=true
KOI_NODE_NAME={{NODE_NAME}}
KOI_STATE_DIR={{STATE_DIR}}
# WireGuard mesh IP -- reachable by all federation peers
KOI_BASE_URL=http://{{WG_IP}}:8351
KOI_STRICT_MODE=false
KOI_NET_REQUIRE_APPROVED_EDGE_FOR_POLL=true
KOI_ENFORCE_SOURCE_KEY_RID_BINDING=true
