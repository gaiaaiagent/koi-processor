<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.personal-koi.substack-sensor</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/darrenzal/projects/koi-processor-runtime/scripts/run_substack_sensor.sh</string>
    </array>

    <key>WorkingDirectory</key>
    <string>/Users/darrenzal/projects/koi-processor-runtime</string>

    <!-- Daily at 07:15 local; ingests only archive posts not already in koi_memories -->
    <key>StartCalendarInterval</key>
    <array>
        <dict>
            <key>Hour</key>
            <integer>7</integer>
            <key>Minute</key>
            <integer>15</integer>
        </dict>
    </array>

    <key>RunAtLoad</key>
    <false/>

    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin:/opt/homebrew/bin</string>
        <key>HOME</key>
        <string>/Users/darrenzal</string>
    </dict>

    <key>StandardOutPath</key>
    <string>/Users/darrenzal/projects/koi-processor-runtime/logs/substack-sensor.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/darrenzal/projects/koi-processor-runtime/logs/substack-sensor.error.log</string>

    <key>Nice</key>
    <integer>10</integer>
</dict>
</plist>
