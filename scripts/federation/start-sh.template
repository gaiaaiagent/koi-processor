#!/bin/bash
# Personal KOI-processor start script for {{NODE_NAME}}
# Runs on port 8351 in personal mode
# Generated by setup-node.sh

set -e

cd {{KOI_PROCESSOR_PATH}}

# Source environment (use venv if available)
if [ -f venv/bin/activate ]; then
    source venv/bin/activate
fi

# Ensure cryptography is installed (required for KOI-net federation)
pip install -q cryptography 2>/dev/null || true

# Load base environment variables (but personal.env will override)
if [ -f .env ]; then
    set -a
    source .env
    set +a
fi

# Load personal config (overrides base .env, including API keys)
if [ -f config/personal.env ]; then
    set -a
    source config/personal.env
    set +a
fi

# Personal mode overrides
export KOI_MODE=personal
export KOI_API_PORT=8351
export POSTGRES_URL="postgresql:///personal_koi"

# Generate admin token for edge approval if not already present
KOI_STATE_DIR="${KOI_STATE_DIR:-{{STATE_DIR}}}"
mkdir -p "$KOI_STATE_DIR"
ADMIN_TOKEN_FILE="$KOI_STATE_DIR/admin_token"
if [ ! -f "$ADMIN_TOKEN_FILE" ]; then
    python3 -c "import secrets; print(secrets.token_urlsafe(32))" > "$ADMIN_TOKEN_FILE"
    chmod 600 "$ADMIN_TOKEN_FILE"
    echo "Generated new admin token at $ADMIN_TOKEN_FILE"
fi
export KOI_ADMIN_TOKEN="$(cat "$ADMIN_TOKEN_FILE")"

# Start the personal KOI backend
exec uvicorn api.personal_ingest_api:app --host 0.0.0.0 --port 8351 --log-level info
