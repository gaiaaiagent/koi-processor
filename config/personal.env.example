# KOI Processor - Personal Deployment Configuration (Example)
# Copy to personal.env and fill in real values.
#
# Usage: source config/personal.env && python -m api.koi_content_api

# ============================================
# DEPLOYMENT MODE
# ============================================
KOI_MODE=personal
DEPLOYMENT_PROFILE=personal

# ============================================
# DATABASE CONFIGURATION
# ============================================
POSTGRES_URL=postgresql://youruser:@localhost:5432/personal_koi

# ============================================
# KOI PIPELINE CONFIGURATION
# ============================================
USE_ISOLATED_TABLES=true
KOI_COORDINATOR_URL=http://localhost:8005
EVENT_BRIDGE_PORT=8100

# ============================================
# EMBEDDING CONFIGURATION
# ============================================
OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# DEEP-EXTRACTION TRANSPORT (optional)
# ============================================
# Which model runs entity/fact/discourse extraction (extract_deep_documents.py).
# Default transport is 'claude_p' (Claude Code subscription, $0) — leave it unset
# for that. Set these ONLY to opt into a different transport for a run/batch job.
#
# DOC_EXTRACTOR_TRANSPORT=claude_p        # claude_p (default) | api | openai
# DOC_EXTRACTOR_MODEL=claude-sonnet-4-6   # model for claude_p/api
#
# 'openai' = any OpenAI-compatible /v1/chat/completions endpoint — BRING YOUR OWN
# model (public OpenAI, self-hosted vLLM/Ollama, a provider-hosted open model).
# Defaults target public OpenAI, so with just an OPENAI_API_KEY it works out of box;
# override BASE_URL/MODEL to point at your own infra.
# DOC_EXTRACTOR_OPENAI_BASE_URL=https://api.openai.com/v1
# DOC_EXTRACTOR_OPENAI_MODEL=gpt-4o-mini
# DOC_EXTRACTOR_OPENAI_API_KEY=            # falls back to OPENAI_API_KEY if unset
# DOC_EXTRACTOR_OPENAI_NO_THINK=0          # =1 for reasoning models on vLLM (Qwen3 etc.)
# DOC_EXTRACTOR_REPAIR_PASSES=2            # re-ask smaller models on invalid JSON

# ============================================
# PERSONAL KOI API
# ============================================
KOI_API_PORT=8351
WEB_SENSOR_ENABLED=true
QUERY_ENDPOINT_ENABLED=true
VAULT_SYNC_ENABLED=true

# ============================================
# OBSIDIAN VAULT CONFIGURATION
# ============================================
OBSIDIAN_VAULT_PATH=~/Documents/Notes
OBSIDIAN_VAULT_NAME=personal

# ============================================
# FUSEKI CONFIGURATION (Optional)
# ============================================
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=personal-koi
# FUSEKI_USER=admin
# FUSEKI_PASSWORD=

# ============================================
# PROCESSING CONFIGURATION
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CONTENT_LENGTH=50
CHUNK_PROCESSING_DELAY=0.05

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# CODE GRAPH (disabled for personal)
# ============================================
CODE_GRAPH_ENABLED=false

# ============================================
# KNOWLEDGE GRAPH EXTRACTION
# ============================================
KG_EXTRACTION_ENABLED=true

# ============================================
# KOI-NET FEDERATION
# ============================================
KOI_NET_ENABLED=true
KOI_NODE_NAME=darren-personal
KOI_STATE_DIR=/path/to/koi-state
KOI_BASE_URL=http://10.100.0.2:8351
KOI_STRICT_MODE=false
KOI_NET_REQUIRE_APPROVED_EDGE_FOR_POLL=true
KOI_ENFORCE_SOURCE_KEY_RID_BINDING=true

# ============================================
# TERMINUSDB (Graph Storage Layer - Optional)
# ============================================
# Set TERMINUSDB_ENABLED=true to enable graph sync.
# TerminusDB runs alongside PostgreSQL as eventual-consistency store.
TERMINUSDB_ENABLED=true
TERMINUSDB_URL=http://127.0.0.1:6363/
TERMINUSDB_DB=koi_knowledge_graph
TERMINUSDB_TEAM=admin
TERMINUSDB_KEY=changeme

# ============================================
# MEDIAWIKI SENSOR (Optional — live-sync external MediaWikis)
# ============================================
# Set to true to start the background sensor that polls registered wikis
# in mediawiki_wikis (sync_mode='poll', status='active').
MEDIAWIKI_SENSOR_ENABLED=false
MEDIAWIKI_POLL_INTERVAL=600
