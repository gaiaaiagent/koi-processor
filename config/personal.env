# KOI Processor - Personal Deployment Configuration
# For local/personal knowledge graph (not Regen production)
#
# Usage: source config/personal.env && python -m api.koi_content_api

# ============================================
# DEPLOYMENT MODE
# ============================================
KOI_MODE=personal

# ============================================
# DATABASE CONFIGURATION
# ============================================
# Personal PostgreSQL database (separate from Regen production)
POSTGRES_URL=postgresql://darrenzal:@localhost:5432/personal_koi

# ============================================
# KOI PIPELINE CONFIGURATION
# ============================================
USE_ISOLATED_TABLES=true

# Local KOI Coordinator (if running)
KOI_COORDINATOR_URL=http://localhost:8005

# Event Bridge port
EVENT_BRIDGE_PORT=8100

# ============================================
# EMBEDDING CONFIGURATION
# ============================================
# OpenAI API key for entity embeddings (same as production)
# Inherits from main .env - set here only if you want to override
# OPENAI_API_KEY=sk-...
EMBEDDING_MODEL=text-embedding-ada-002

# ============================================
# PERSONAL KOI API
# ============================================
# Port for personal KOI ingest API
KOI_API_PORT=8351

# ============================================
# OBSIDIAN VAULT CONFIGURATION
# ============================================
OBSIDIAN_VAULT_PATH=~/Documents/Notes
OBSIDIAN_VAULT_NAME=personal

# ============================================
# FUSEKI CONFIGURATION (Optional)
# ============================================
# Local Fuseki triple store (if running)
FUSEKI_URL=http://localhost:3030
FUSEKI_DATASET=personal-koi
# FUSEKI_USER=admin
# FUSEKI_PASSWORD=

# ============================================
# PROCESSING CONFIGURATION
# ============================================
CHUNK_SIZE=1000
CHUNK_OVERLAP=200
MIN_CONTENT_LENGTH=50
CHUNK_PROCESSING_DELAY=0.05

# ============================================
# LOGGING
# ============================================
LOG_LEVEL=INFO

# ============================================
# CODE GRAPH (disabled for personal)
# ============================================
CODE_GRAPH_ENABLED=false

# ============================================
# KNOWLEDGE GRAPH EXTRACTION
# ============================================
KG_EXTRACTION_ENABLED=true
