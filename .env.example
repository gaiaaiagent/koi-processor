# KOI Processor Environment Configuration
# Copy this file to .env and fill in your values

# ============================================
# DATABASE CONFIGURATION
# ============================================
# PostgreSQL connection string
POSTGRES_URL=postgresql://postgres:postgres@localhost:5433/eliza

# ============================================
# KOI PIPELINE CONFIGURATION
# ============================================
# Use isolated tables for deduplication (recommended: true)
USE_ISOLATED_TABLES=true

# KOI Coordinator endpoint
KOI_COORDINATOR_URL=http://localhost:8200

# KOI Event Bridge port
EVENT_BRIDGE_PORT=8100

# ============================================
# EMBEDDING CONFIGURATION
# ============================================
# BGE Server endpoint
BGE_API_URL=http://localhost:8090/encode
BGE_SERVER_PORT=8090

# Optional: Ollama for alternative embeddings
# OLLAMA_API_URL=http://localhost:11434
# EMBEDDING_MODEL=embeddinggemma

# ============================================
# MCP SERVER CONFIGURATION (Optional)
# ============================================
# MCP Server port for semantic search
MCP_SERVER_PORT=3000

# ============================================
# AGENT CONFIGURATION
# ============================================
# Default agent ID for memories (optional)
# DEFAULT_AGENT_ID=8e1e4498-b3c8-0fae-ad1f-e90d1c1a4331

# ============================================
# PROCESSING CONFIGURATION
# ============================================
# Text chunking parameters
CHUNK_SIZE=1000
CHUNK_OVERLAP=200

# Minimum content length to process
MIN_CONTENT_LENGTH=50

# Rate limiting (seconds between chunks)
CHUNK_PROCESSING_DELAY=0.05

# ============================================
# LOGGING CONFIGURATION
# ============================================
# Log level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log file location (optional)
# LOG_FILE=/var/log/koi-processor/event-bridge.log

# ============================================
# PRODUCTION SETTINGS
# ============================================
# Enable production optimizations
# PRODUCTION_MODE=false

# SSL/TLS for database connection
# POSTGRES_SSL_MODE=require

# API authentication (optional)
# API_KEY=your-secret-api-key

# CORS origins (comma-separated)
# CORS_ORIGINS=http://localhost:3000,https://yourdomain.com

# ============================================
# MONITORING (Optional)
# ============================================
# Prometheus metrics endpoint
# ENABLE_METRICS=true
# METRICS_PORT=9090

# Sentry error tracking
# SENTRY_DSN=https://your-key@sentry.io/project-id

# ============================================
# DEVELOPMENT SETTINGS
# ============================================
# Auto-reload on code changes
# DEV_MODE=true

# Mock BGE server for testing
# USE_MOCK_BGE=false

# Verbose SQL logging
# SQL_ECHO=false